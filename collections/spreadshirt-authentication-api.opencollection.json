{
  "opencollection": "1.0.0",
  "info": {
    "name": "Spreadconnect fulfillment service REST Articles Authentication API",
    "version": "0.1.0"
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "REST API Authentication Info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.spreadconnect.app/authentication",
            "auth": {
              "type": "apikey",
              "key": "X-SPOD-ACCESS-TOKEN",
              "value": "{{X-SPOD-ACCESS-TOKEN}}",
              "placement": "header"
            }
          },
          "docs": "This resource could be used, to test your authentication and get some basic information about your authentication."
        }
      ]
    }
  ],
  "bundled": true
}